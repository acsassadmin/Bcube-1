# ── Razorpay (https://dashboard.razorpay.com) ─────────────
# Get your keys from: Razorpay Dashboard -> Developers -> API Keys
# Use test keys (rzp_test_...) for development

VITE_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"   # Public key for browser (Razorpay SDK)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"        # Server key ID (for Nitro function)
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxx"    # Server key secret (for Nitro function)

# ── Supabase (https://supabase.com) ──────────────────────
# Copy this file to .env and fill in the values from your own Supabase project.

# Public values: safe to ship to the browser
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Public base URL of the site-media storage bucket.
VITE_MEDIA_BASE_URL="https://YOUR-PROJECT.supabase.co/storage/v1/object/public/site-media"

# Server-side copies (used during server rendering)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Secret: never commit, never expose to the browser.
# Only needed by the one-off scripts in scripts/ (media upload).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
